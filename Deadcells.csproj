<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(Sts2Dir)' != ''">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <CopyToGame Condition="'$(CopyToGame)' == ''">false</CopyToGame>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Deadcells\**" />
    <EmbeddedResource Remove="Deadcells\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="[3.2.1]" PrivateAssets="all" />
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Steamworks.NET">
      <HintPath>$(Sts2DataDir)\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Scripts\potions\" />
  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Sts2DataDir)' == ''" Text="Set Sts2DataDir to the game assembly directory in local.props or with -p:Sts2DataDir=..." />
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="Missing $(Sts2DataDir)/sts2.dll" />
    <Error Condition="!Exists('$(Sts2DataDir)/0Harmony.dll')" Text="Missing $(Sts2DataDir)/0Harmony.dll" />
    <Error Condition="!Exists('$(Sts2DataDir)/Steamworks.NET.dll')" Text="Missing $(Sts2DataDir)/Steamworks.NET.dll" />
  </Target>

  <Target Name="Copy Mod" AfterTargets="PostBuildEvent" Condition="'$(CopyToGame)' == 'true'">
    <Error Condition="'$(Sts2Dir)' == ''" Text="CopyToGame requires Sts2Dir." />
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
  </Target>
</Project>
